# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` — it holds live API keys. See .gitignore.

# ====================== RETRIEVAL ======================
# Default number of chunks retrieved per query (can be overridden per-request)
TOP_K=3

# ====================== EMBEDDING MODEL ======================
# Must be identical in rag_pipeline.ipynb (builds the FAISS index) and
# rag_api.py (embeds incoming queries), or retrieval breaks. This is an
# E5-family model — both files already apply the "passage: " / "query: "
# prefix convention it expects.
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ====================== GEMINI (generation) ======================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# ====================== GROQ (query routing) ======================
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# ====================== PDF PIPELINE (optional overrides) ======================
# PDF_PATH=Harry Potter.pdf
# MD_PATH=harry_potter.md
# MIN_PAGE_CHARS=30
